#: main.py
msgid "Super Chat"
msgstr "Super Chat"

#. Traductores: {etiqueta} es «Super Chat» o «Regalo».
#: main.py
#, python-brace-format
msgid "{etiqueta} de {autor}: {monto}. {mensaje}"
msgstr "{etiqueta} from {autor}: {monto}. {mensaje}"

#: main.py
#, python-brace-format
msgid "{etiqueta} de {autor}: {monto}"
msgstr "{etiqueta} from {autor}: {monto}"

#. Traductores: autor cuando el chat no da el nombre; una sola palabra.
#. Traductores: autor cuando YouTube no da el nombre; una sola palabra.
#: guyrapu/voice/tts_worker.py guyrapu/youtube/youtube_api.py main.py
msgid "Usuario"
msgstr "User"

#: main.py
msgid "Chat reconectado."
msgstr "Chat reconnected."

#: main.py
msgid "La conexión se cerró y la reconexión está desactivada."
msgstr "The connection closed and reconnection is turned off."

#: main.py
msgid "El directo terminó. Chat desconectado."
msgstr "The live stream ended. Chat disconnected."

#: main.py
#, python-brace-format
msgid "Se agotaron los {n} intentos de reconexión."
msgstr "All {n} reconnection attempts failed."

#: main.py
msgid "segundo"
msgstr "second"

#: main.py
msgid "segundos"
msgstr "seconds"

#. Traductores: {segundos} puede ser 1; {unidad}, segundo o segundos; {total},
#. el máximo.
#: main.py
#, python-brace-format
msgid ""
"Se perdió la conexión con el chat. Reintentando en {segundos} {unidad} "
"(intento {intento} de {total})."
msgstr ""
"Lost connection to the chat. Retrying in {segundos} {unidad} (attempt "
"{intento} of {total})."

#: main.py
#, python-brace-format
msgid ""
"Se perdió la conexión con el chat. Reintentando en {segundos} {unidad} "
"(intento {intento})."
msgstr ""
"Lost connection to the chat. Retrying in {segundos} {unidad} (attempt "
"{intento})."

#: main.py
msgid "No se encontró la biblioteca pytchat. Ejecuta instalar.bat."
msgstr "Could not find the pytchat library. Run instalar.bat."

#: main.py
msgid "Conectando al directo…"
msgstr "Connecting to the live stream…"

#: main.py
msgid "Conectado. Esperando mensajes…"
msgstr "Connected. Waiting for messages…"

#: main.py
msgid "Chat en lectura."
msgstr "Chat is being read."

#: main.py
msgid "Demasiados errores consecutivos."
msgstr "Too many consecutive errors."

#: main.py
msgid "No se reconoce el ID del vídeo. Comprueba el enlace."
msgstr "The video ID is not recognized. Check the link."

#: main.py
msgid ""
"YouTube todavía no muestra este vídeo. Ocurre en los primeros segundos de "
"un directo y siempre con los directos privados."
msgstr ""
"YouTube does not show this video yet. This happens in the first seconds of "
"a live stream, and always with private live streams."

#: main.py
msgid "Este directo es privado. No se puede acceder."
msgstr "This live stream is private. It cannot be accessed."

#: main.py
msgid "El chat está restringido a miembros del canal."
msgstr "Chat is restricted to channel members."

#: main.py
msgid "El directo terminó o no está disponible."
msgstr "The live stream ended or is not available."

#: main.py
msgid "El vídeo no existe. Comprueba el enlace."
msgstr "The video does not exist. Check the link."

#. Traductores: {error} es el detalle técnico.
#: main.py
#, python-brace-format
msgid "No se pudo conectar: {error}"
msgstr "Could not connect: {error}"

#. Traductores: {app} es el nombre de la aplicación.
#: main.py
#, python-brace-format
msgid ""
"{app} ya se está ejecutando.\n"
"Cierra la otra ventana antes de abrir una nueva."
msgstr ""
"{app} is already running.\n"
"Close the other window before opening a new one."

#: main.py
msgid ""
"No se pudo iniciar el motor de voz.\n"
"\n"
"Comprueba que tienes al menos una voz instalada en\n"
"Configuración → Hora e idioma → Voz."
msgstr ""
"Could not start the voice engine.\n"
"\n"
"Make sure you have at least one voice installed in\n"
"Settings → Time & language → Speech."

#. Traductores: {detalle} es el error técnico.
#: main.py
#, python-brace-format
msgid ""
"wxPython no está instalado.\n"
"Ejecuta instalar.bat.\n"
"\n"
"{detalle}"
msgstr ""
"wxPython is not installed.\n"
"Run instalar.bat.\n"
"\n"
"{detalle}"

#: guyrapu/ai/consulta.py
msgid "Respuesta incompleta: alcanzó la longitud máxima elegida en Preferencias."
msgstr "Incomplete response: reached the maximum length chosen in Preferences."

#: guyrapu/ai/consulta.py
msgid "Este modelo no está en el nivel gratuito de tu clave. Elige otro modelo."
msgstr "This model is not in your key's free tier. Choose another model."

#: guyrapu/ai/consulta.py
msgid "Elige un proveedor en Preferencias, Inteligencia artificial."
msgstr "Choose a provider in Preferences, Artificial intelligence."

#: guyrapu/ai/consulta.py
msgid "Elige un modelo en Preferencias, Inteligencia artificial."
msgstr "Choose a model in Preferences, Artificial intelligence."

#: guyrapu/ai/consulta.py
msgid ""
"Escribe una dirección válida para el proveedor en Preferencias, "
"Inteligencia artificial."
msgstr ""
"Type a valid address for the provider in Preferences, Artificial "
"intelligence."

#: guyrapu/ai/consulta.py
msgid ""
"El proveedor rechazó la clave. Revísala en Preferencias, Inteligencia "
"artificial."
msgstr ""
"The provider rejected the key. Check it in Preferences, Artificial "
"intelligence."

#: guyrapu/ai/consulta.py
msgid "Se agotó la cuota del proveedor. Espera unos minutos o elige otro modelo."
msgstr "The provider quota is exhausted. Wait a few minutes or choose another model."

#: guyrapu/ai/consulta.py
msgid ""
"El proveedor no ofrece ese modelo. Elige otro en Preferencias, Inteligencia"
" artificial."
msgstr ""
"The provider does not offer that model. Choose another one in Preferences, "
"Artificial intelligence."

#: guyrapu/ai/consulta.py
msgid "El proveedor bloqueó la respuesta con su filtro de contenido."
msgstr "The provider blocked the response with its content filter."

#: guyrapu/ai/consulta.py
msgid ""
"El modelo usó todo el límite de la respuesta en razonar y no respondió. "
"Elige una respuesta más larga en Preferencias."
msgstr ""
"The model used the whole response limit on reasoning and gave no answer. "
"Choose a longer response in Preferences."

#: guyrapu/ai/consulta.py
msgid "El modelo no devolvió ninguna respuesta. Vuelve a intentarlo."
msgstr "The model returned no response. Try again."

#: guyrapu/ai/consulta.py
msgid "El proveedor devolvió un error. Vuelve a intentarlo más tarde."
msgstr "The provider returned an error. Try again later."

# "
# la"
#: guyrapu/ai/consulta.py
msgid ""
"El proveedor rechazó la consulta. Puede que el modelo ya no esté "
"disponible: en Preferencias, Inteligencia artificial, pulsa Actualizar "
"lista de modelos o elige otro."
msgstr ""
"The provider rejected the request. The model may no longer be available: in"
" Preferences, Artificial intelligence, press Refresh model list or choose "
"another one."

#: guyrapu/ai/consulta.py
msgid "No hay conexión con el proveedor. Comprueba la conexión a internet."
msgstr "There is no connection to the provider. Check your internet connection."

#: guyrapu/ai/consulta.py
msgid "El proveedor tardó demasiado en responder. Vuelve a intentarlo."
msgstr "The provider took too long to respond. Try again."

#: guyrapu/ai/consulta.py
#, python-brace-format
msgid ""
"Falta la clave de {proveedor}. Guárdala en Preferencias, Inteligencia "
"artificial."
msgstr ""
"The {proveedor} key is missing. Save it in Preferences, Artificial "
"intelligence."

#: guyrapu/ai/consulta.py
msgid "Agrega una captura antes de preguntar."
msgstr "Add a screenshot before asking."

#: guyrapu/ai/consulta.py
msgid "Escribe una pregunta."
msgstr "Type a question."

#: guyrapu/ai/consulta.py
msgid "No se pudo completar la consulta. Vuelve a intentarlo."
msgstr "Could not complete the request. Try again."

#: guyrapu/ai/conversacion.py
msgid ""
"Revisa esta captura de la transmisión como si fueras el público. Primero di"
" si hay algún problema: algo en negro, cortado, tapado por otra cosa, fuera"
" de cuadro, borroso o con texto que no se lee. Si no hay ninguno, empieza "
"diciendo que todo se ve bien. Después describe en pocas frases qué se ve y "
"dónde está cada cosa, con posiciones simples como arriba a la izquierda o "
"en el centro, y menciona brevemente los colores y los adornos."
msgstr ""
"Review this screenshot of the broadcast as if you were the audience. First "
"say if there is anything wrong: something black, cut off, covered by "
"something else, out of frame, blurry, or with text that cannot be read. If "
"there is nothing wrong, start by saying everything looks fine. Then "
"describe in a few sentences what is shown and where each thing is, using "
"simple positions like top left or center, and briefly mention colors and "
"decorations."

#: guyrapu/ai/conversacion.py
msgid ""
"Eres el asistente de un streamer ciego que transmite con OBS. Responde "
"siempre en español, en prosa breve, sin markdown, sin listas, sin títulos y"
" sin emojis: la respuesta se lee con un lector de pantalla. Ve directo a lo"
" que se pregunta. Si algo no se distingue en la imagen, dilo en vez de "
"suponer. Cuando recibas la lista de fuentes de OBS, usa sus nombres para "
"decir qué es cada cosa que se ve."
msgstr ""
"You are the assistant of a blind streamer who broadcasts with OBS. Always "
"respond in English, in brief prose, with no markdown, no lists, no "
"headings, and no emojis: the response is read with a screen reader. Go "
"straight to what is asked. If something cannot be made out in the image, "
"say so instead of guessing. When you receive the OBS source list, use its "
"names to say what each thing shown is."

#: guyrapu/ai/conversacion.py
msgid "Lo que OBS informa de la escena al aire:"
msgstr "What OBS reports about the live scene:"

#. Traductores: fila del historial; {fuente} es OBS o TikTok y {hora} la hora.
#: guyrapu/ai/conversacion.py
#, python-brace-format
msgid "Captura: {fuente}, {hora}"
msgstr "Screenshot: {fuente}, {hora}"

#. Traductores: filas del historial; {texto} es lo escrito o respondido.
