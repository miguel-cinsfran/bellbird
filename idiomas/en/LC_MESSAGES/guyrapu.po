#: guyrapu/core/acerca_de.py
#, python-brace-format
msgid ""
"{app} {version}\n"
"\n"
"Lee en voz alta el chat de los directos de YouTube y TikTok. Incluye "
"moderación, comentarios, reproductor, música, descargas y control de OBS "
"Studio.\n"
"\n"
"Autor: Miguel Ángel Insfrán\n"
"\n"
"Licencia: GPL versión 3, con condiciones adicionales. Los detalles están en"
" los archivos LICENSE y NOTICE, en la carpeta de la aplicación.\n"
"\n"
"Repositorio: {url}"
msgstr ""
"{app} {version}\n"
"\n"
"Reads the chat of YouTube and TikTok live streams aloud. Includes "
"moderation, comments, a player, music, downloads, and OBS Studio control.\n"
"\n"
"Author: Miguel Ángel Insfrán\n"
"\n"
"License: GPL version 3, with additional terms. Details are in the LICENSE "
"and NOTICE files, in the application folder.\n"
"\n"
"Repository: {url}"

